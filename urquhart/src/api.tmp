
{"status":"Success","status_code":200,"message":"Get a cryptogram.","data":{"id":8,"cipher_key_id":null,"name":"An encrypted postcard from the Isle of Wight","description":"<p><span style=\"color: rgb(51, 51, 51);\">In 1905 an unknown person sent an encrypted postcard depicting the Shanklin Chine to a Miss <\/span>Grumbridge<span style=\"color: rgb(51, 51, 51);\"> living in the Sugden Road in Clapham, a district of London. <\/span><\/p><p><br><\/p><p>Solved by blog reader Thomas (Klausis Krypto Kolumne).<\/p>","availability_type":"other","availability":"Unknown","category":{"id":10,"name":"Monoalphabetic","children":[]},"sub_category":{"id":2,"name":"Substitution"},"date":null,"date_around":"1905","thumb":"https:\/\/api.hcportal.eu\/media\/28\/conversions\/25531532085286-large.jpg","used_chars":null,"language":{"id":6,"name":"English"},"location":{"id":3,"continent":"Europe","name":null},"recipient":{"id":9,"name":"Dora Grumbridge"},"sender":{"id":2,"name":"Unknown"},"solution":{"id":2,"name":"Solved"},"folder":null,"state":{"id":"approved","title":"Approved","show":true},"created_by":{"id":2,"first_name":"Eugen","last_name":"Antal"},"note":null,"tags":[{"id":3,"name":"Postcard","type":"cryptogram"}],"datagroups":[{"id":19,"description":"Links and references","data":[{"id":33,"title":"Source","type":"link","link":"https:\/\/scienceblogs.de\/klausis-krypto-kolumne\/2018\/07\/11\/an-encrypted-postcard-from-the-isle-of-wight\/"}]},{"id":20,"description":"Cryptogram","data":[{"id":34,"title":"Cryptogram image","type":"image","image":{"thumb":"https:\/\/api.hcportal.eu\/media\/29\/conversions\/19421532345488-thumb.jpg","big":"https:\/\/api.hcportal.eu\/media\/29\/conversions\/19421532345488-big.jpg","large":"https:\/\/api.hcportal.eu\/media\/29\/conversions\/19421532345488-large.jpg","original":"https:\/\/api.hcportal.eu\/media\/29\/19421532345488.jpg"}}]},{"id":21,"description":"Solution","data":[{"id":35,"title":"Solution","type":"text","text":"Dear Dora,\nI am writing as promised and hope you will love this card. Georgie Tear (?) sent her love to you. Was pleased to hear Billy. Was getting on.i(?). Am sorry I have no prettier card to send you but will buy you a pretty one soon. Love to Auntie and self Beattie(?)"}]}],"created_at":"2025-11-20 08:20:15","updated_at":"2025-11-20 08:20:16"}}