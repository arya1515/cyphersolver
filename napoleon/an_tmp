<script type="text/javascript">
$('#formAuthentication').on('submit',function(event) {
	event.preventDefault();
	var formAuthent = {
		j_username : $("#j_username").val(),
		j_password : $("#j_password").val(),
		j_loginType : $("#j_loginType").val(),
	};
	
	// Si prsent, le message d'erreur
	// est supprim lors de chaque
	// tentative d'authentification.
	$("#formAuthentication .accueil_arror").empty();
	
	// Une icne de chargement est affiche
	// durant la connexion de l'utilisateur.
	$("#ecranConnexionUtilisateur").removeClass("nodisplay").startLoading();
	
	if ($("#ecranConnexionUtilisateur").find("span.message").size() === 0) {
		$("#ecranConnexionUtilisateur").append("<span class=\"message\">Connexion en cours</span>");
	}
	
	$.ajax({
		type: 'post',
		cache: false,
        url: '/siv/j_spring_security_check',
        data: ({
    		j_username: formAuthent.j_username,
    		j_password: formAuthent.j_password,
    		j_loginType: formAuthent.j_loginType,
    	}),
    	dataType: 'json',
        success: function(data) {
        	// La redirection n'est fonctionnelle
        	// que si nous avons pu nous authentifier.
        	if (formAuthent.j_loginType == 'REDIRECTION_NEEDED') {
				location.replace('/siv/accueil/monEspace.action');
			} else {
				window.location.href = window.location.href;
			}
        },
		complete: function(data) {
			
			
			
			// Si la transformation JSON ne fonctionne pas,
			// cela signifie que nous n'avons pas
			// pu nous authentifier.
			try {
				JSON.parse(data.responseText.replace(/\r\n/g, ''));
			}
			
			// Un message d'erreur sera alors affich.
			// Nous devons galement masquer
			// l'icne de chargement.
			catch(e) {
				$("#ecranConnexionUtilisateur").addClass("nodisplay").stopLoading();
				var errorElement = document.createElement("ul");
        		$(errorElement).addClass("errorMessage");
        		$(errorElement).html("<li><span>Erreur d'authentification</span></li>");
        		$("#formAuthentication .accueil_arror").html(errorElement);
			}
		}
	});
});
</script>
