 				|| ($('.notice nav#ml').height() - $('.notice nav#ml > button.action').outerHeight(true)) > $('.content_wrapper.clearfix').height()) {
 				$('.notice nav#ml').css('height', $('.content_wrapper.clearfix').height() - parseInt($('.notice nav#ml').css('margin-top')));
 			}
 			
 			else {
 				$('.notice nav#ml').css('height', $(window).height() - 60);
 			}
 			
 			// La largeur du menu de gauche
 			// doit s'adapter à la résolution de l'écran.
 			
 			// Cela vient du fait que les propriétés de
 			// pourcentage CSS ne s'appliquent pas correctement
 			// lorsque le menu est fixé.
 			
 			$(".notice nav#ml").css('max-width', $(".notice nav#ml").closest(".content_wrapper").width() * 0.8);
 			
 			// La fonctionnalité d'ouverture du menu de gauche
 			// n'étant pas active pour les grandes résolutions,
 			// nous devons supprimer les attributs servant
 			// à le dé / replier lorsque la largeur de l'image
 			// est plus petite.
 			
 			if ($(window).width() > 1024) {
 				
 				if ($('.notice nav#ml').hasClass('open')) {
 					$('.notice nav#ml').removeClass('open');
 				}
 				
 				if ($('.notice nav#ml').is(":hidden")) {
 					$('.notice nav#ml').show();
 				}
 			}
 			
 			// Le comportement ci-dessous est lié aux instructions
 			// "ScrollToFixed" : si l'élément suivant le menu de gauche
 			// n'est pas celui créé par le plugin, alors nous devons
 			// nous assurer qu'il se repositionne correctement
 			// lorsque nous modifions la taille de la fenêtre.
 			
 			if ($('.notice nav#ml').next(":not(.sections_group):not(#modalVisionneuse):not(script)").size() === 0) {
 				$('.notice nav#ml').css({left: '', position: ''});
 			}
		}
		
		function resizePage() {
			
			// Dans le détail du contenu d'un inventaire,
			// on sauvegarde la position actuelle du curseur dans le plan de classement,
			// afin de la restaurer après le redimensionnement du document.
			var oldPdcScroll = null;
			if ("false" === "true" && document.getElementById("planDeClassement")) {
				oldPdcScroll = document.getElementById("planDeClassement").scrollTop;
			}
			
			detachScrollToFixedProperties();
			resizeNav();
			loadScrollToFixedProperties();
			
			// Dans le détail du contenu d'un inventaire,
			// on restaure l'ancienne position du curseur dans le plan de classement,
			// afin de pouvoir traiter correctement les instructions
			// suivantes de positionnement dans le document.
			if (oldPdcScroll !== null) {
				document.getElementById("planDeClassement").scrollTop = 0;
				$("#planDeClassement").scrollTop(oldPdcScroll);
			}
		}
		
		function resizeFixedElements() {
			
			if ($(window).width() > 1024 && $('#headerud').css("position") === "fixed") {
				var oldWidth = Math.floor($('#headerud').outerWidth(true));
				var newWidth = Math.floor($('#headerud').parent().width());
				var newLeft = parseInt($('#headerud').css("left")) - (newWidth - oldWidth);
				$('#headerud').css({left: newLeft, width: newWidth});
			}
		}
		
		$(window).load(function() {
			
			// On ajoute une infobulle
			// pour le bouton du menu burger
			// situé dans celui de gauche
			// de la page de consultation
			// des inventaires.
			var stepTitle = "Affiner avec plus de critères", stepContent = "Des critères d'affinage sont mis à votre disposition pour vous aider à poursuivre votre recherche.";
			
			if ("false" === "false") {
				stepTitle = ("false" === "true") ? "Voir le plan de classement" : "Sommaire";
				stepContent = ("false" === "true") ? "Naviguer dans le plan de classement de l'inventaire" : new String();
			}
			
			tour.addStep({
				element: "#ir_menu",
		    	title: stepTitle,
		    	content: stepContent,
		    	template: "<div class='popover tour'><div class='arrow'></div><h3 class='popover-title'></h3><div class='popover-content'></div><div class='popover-navigation'></div></div>"
			});
			
			handleLibelleDisplay("ir_menu");
			
	 		resizeNav();
			loadScrollToFixedProperties();
			
			// Lors du défilement de la fenêtre,
			// nous devons nous assurer que seul
			// le dernier texte de rubrique fixé
			// à l'écran est visible.
			$(window).scroll(function() {
				
				$('.scrollto-section h2').filter(function() {
					return $(this).css("position") === "fixed";
				}).filter(":last").css("visibility", "visible").addBack().filter(":not(:last)").css("visibility", "hidden");
			});
			
			if ("false" === "true") {
				$('.heading-ud:visible:not(.disabled)').filter(function() {
					var ev = $._data(this, 'events');
					return !(ev && ev.click);
				}).click(function(e){
					afficherUD($(this).attr("id").substring("heading_".length));
				});
				
				// Le titre de l'unité de description
				// actuellement consultée nécessite
				// d'être redimensionné lorsqu'il
				// est fixé à l'écran.
				
				// Ces instructions ne fonctionnent
				// que dans le cas de hautes résolutions d'écran.
				// Afin d'éviter des problèmes de valeurs
				// approximatives, elles seront toutes entières.
				
				$(".notice nav#ml .rg-right").mousedown(function() {
					$(this).on("mousemove mouseout", function() {
						resizeFixedElements();
					});
				});
				
				$(document).mouseup(function() {
					
					var ev = $(".notice nav#ml .rg-right").data('events');
					if (ev && ev.mousemove) {
						$(".notice nav#ml .rg-right").off("mousemove mouseout");
						resizeFixedElements();
					}
				});
			}
		});
		
		$(window).resize(function() {
			handleLibelleDisplay("ir_menu");
			resizePage();
		})
	</script>
